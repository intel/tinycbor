# Initial bytes of CBOR items (RFC 8949), for the parsing fuzzers

# major type 0: unsigned integers
"\x00"
"\x17"
"\x18"
"\x19"
"\x1a"
"\x1b"
# major type 1: negative integers
"\x20"
"\x37"
"\x38"
"\x39"
"\x3a"
"\x3b"
# major type 2: byte strings
"\x40"
"\x57"
"\x58"
"\x59"
"\x5a"
"\x5b"
"\x5f"
# major type 3: text strings
"\x60"
"\x77"
"\x78"
"\x79"
"\x7a"
"\x7b"
"\x7f"
# major type 4: arrays
"\x80"
"\x97"
"\x98"
"\x99"
"\x9a"
"\x9b"
"\x9f"
# major type 5: maps
"\xa0"
"\xb7"
"\xb8"
"\xb9"
"\xba"
"\xbb"
"\xbf"
# major type 6: tags
"\xc0"
"\xc1"
"\xc2"
"\xc3"
"\xc4"
"\xc5"
"\xd5"
"\xd6"
"\xd7"
"\xd8"
"\xd9"
"\xda"
"\xdb"
"\xd8\x18"
"\xd8\x20"
"\xd9\xd9\xf7"
# major type 7: simple values and floating point
"\xe0"
"\xf4"
"\xf5"
"\xf6"
"\xf7"
"\xf8"
"\xf9"
"\xfa"
"\xfb"
"\xff"
"\xf9\x7c\x00"
"\xf9\xfc\x00"
"\xf9\x7e\x00"
"\xfa\x7f\xc0\x00\x00"
"\xfb\x7f\xf8\x00\x00\x00\x00\x00\x00"
